__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.DS_Store

# Personal/local config
.mcp.json
.loom/
.claude/

# Internal planning docs
PLAN.md
loom_suggestions.md
.env
.env.*
weft-backup-*.json

# OAuth staging/prod secret output files produced by
# scripts/generate_oauth_secrets.sh. NEVER commit these.
.oauth-*.env
.oauth-*-secrets.env

# Benchmark run artifacts — regeneratable, large, and per-run timestamped.
# Source code under benchmarks/ IS tracked; only the results dir is excluded.
benchmarks/**/results/

# Local-only personal acceptance cases — seeded from real Weft data, never
# committed. The README in that directory IS tracked so the convention
# survives even on a fresh clone.
tests/acceptance/cases_local/*
!tests/acceptance/cases_local/README.md
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.DS_Store

# Personal/local config
.mcp.json
.mcp.json.pre-token.bak
.codex/
.loom/
.claude/

# Internal planning docs
PLAN.md
loom_suggestions.md
.env
.env.*
!.env.example
weft-backup-*.json

# OAuth staging/prod secret output files produced by
# scripts/generate_oauth_secrets.sh. NEVER commit these.
.oauth-*.env
.oauth-*-secrets.env

# Benchmark run artifacts — regeneratable, large, and per-run timestamped.
# Source code under benchmarks/ IS tracked; generated outputs stay local.
benchmarks/**/results/
artifacts/continuity/

# Local-only personal acceptance cases — seeded from real Weft data, never
# committed. The README in that directory IS tracked so the convention
# survives even on a fresh clone.
tests/acceptance/cases_local/*
!tests/acceptance/cases_local/README.md

# Drafts / personal writing — kept local until ready to publish.
posts/

# Antigravity / Gemini CLI local config (symlink into ~/.gemini) — tool artifact.
.antigravitycli/documents/.DS_Store
.DS_Store

# Enumeration-eval runtime artifact (CL1 minted cases)
benchmarks/enumeration_eval/minted_cases.jsonl

# LongMemEval local dataset and generated benchmark artifacts.
# Keep benchmark source, tests, README files, and small manifests eligible.
benchmarks/longmemeval/data/*_cleaned.json
benchmarks/longmemeval/runs/
benchmarks/longmemeval/results/
benchmarks/retrieval_recovery_pilot/runs/

# Local worktrees must never become release contents.
**/.worktrees/
/tls-release/

benchmarks/longmemeval/snapshots/*/*.csv.gz
benchmarks/longmemeval/snapshots/*/.complete
!benchmarks/longmemeval/snapshots/*/manifest.json

# Polytoken local session/config state.
.polytoken/

# Weft Environment Variables — Example Configuration
# Copy to .env and fill in actual values. This file is safe to commit.

# ============================================================================
# Outbound Connectors (Daily Brief Delivery)
# ============================================================================

# Select which outbound connector to use for daily_brief delivery.
# Valid values: slack, discord, none (empty = no-op)
# WEFT_OUTBOUND_CONNECTOR=slack

# Slack bot token for daily brief delivery (requires chat:write scope)
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Discord bot token for daily brief delivery
# WEFT_DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Discord channel ID where daily briefs are posted
# WEFT_DISCORD_BRIEF_CHANNEL_ID=1234567890

# Discord channel ID for the inbound "idea dump" watcher (optional).
# When set, the bot enables the message_content PRIVILEGED intent and pipes
# messages posted in this channel through the Weft ingest pipeline, creating
# memories automatically.
# IMPORTANT: Requires manual enablement in the Discord Developer Portal under
#   Bot → Privileged Gateway Intents → Message Content Intent.
#   Discord will reject the gateway connection at runtime if the intent is
#   enabled here but not toggled on in the portal.
# Leave unset to keep the bot in outbound-only mode (default intents only).
# WEFT_DISCORD_IDEA_DUMP_CHANNEL_ID=9876543210

# ============================================================================
# Database
# ============================================================================

# PostgreSQL connection string (standard or custom)
# Default: postgresql://weft:weft_local@localhost:5433/weft
# WEFT_DATABASE_URL=postgresql://user:password@localhost:5432/weft

# ============================================================================
# Redis (Optional — used for request caching and session state)
# ============================================================================

# Redis connection URL
# Default: redis://localhost:6380
# WEFT_REDIS_URL=redis://localhost:6380

# ============================================================================
# Embeddings
# ============================================================================

# Embedding provider: openai (default)
# WEFT_EMBEDDING_PROVIDER=openai

# Embedding model name
# Default: text-embedding-3-small
# WEFT_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# Alerts & Scheduling
# ============================================================================

# Poll interval for alert scheduling (seconds)
# Default: 60
# WEFT_ALERT_POLL_INTERVAL=60

# Batch size for alert dispatch (alerts per poll cycle)
# Default: 50
# WEFT_ALERT_BATCH_SIZE=50

# ============================================================================
# Daily Brief
# ============================================================================

# Time for daily brief delivery (HH:MM format, wall-clock)
# Default: 08:00
# WEFT_DAILY_BRIEF_TIME=08:00

# Timezone for brief schedule (IANA timezone)
# Default: America/New_York
# WEFT_DAILY_BRIEF_TZ=America/New_York

# Slack channel ID or name for brief delivery
# WEFT_DAILY_BRIEF_CHANNEL=#your-channel

# ============================================================================
# Slack Sync
# ============================================================================

# Interval for Slack channel sync (seconds)
# Default: 1800 (30 minutes)
# WEFT_SLACK_SYNC_INTERVAL=1800

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
# WEFT_LOG_LEVEL=INFO

# ============================================================================
# Environment
# ============================================================================

# Environment: local or production
# Default: local
# WEFT_ENV=local

# Weft API key (optional, deprecated in favor of WEFT_TOKENS)
# WEFT_API_KEY=your-api-key-here

# ============================================================================
# Supabase (OAuth 2.1)
# ============================================================================

# Supabase project URL
# SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (publishable) key
# SUPABASE_ANON_KEY=your-anon-key-here

# OAuth enabled flag
# Default: false
# WEFT_OAUTH_ENABLED=false

# OAuth issuer (for OIDC)
# OAUTH_ISSUER=https://your-issuer

# OAuth JWT private key (PEM format)
# OAUTH_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# OAuth session secret
# OAUTH_SESSION_SECRET=your-secret-here

# OAuth access token TTL (seconds)
# Default: 3600 (1 hour)
# OAUTH_ACCESS_TTL_S=3600

# OAuth refresh token TTL (seconds)
# Default: 2592000 (30 days)
# OAUTH_REFRESH_TTL_S=2592000

# Supabase auth provider (email, github, google, etc.)
# Default: email
# WEFT_SUPABASE_AUTH_PROVIDER=email
